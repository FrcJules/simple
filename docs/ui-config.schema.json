{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Présence – configuration de l'interface",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "theme": {
      "type": "object",
      "properties": {
        "background": { "$ref": "#/definitions/color" },
        "text": { "$ref": "#/definitions/color" },
        "primary": { "$ref": "#/definitions/color" },
        "onPrimary": { "$ref": "#/definitions/color" },
        "tile": { "$ref": "#/definitions/color" },
        "accent": { "$ref": "#/definitions/color" },
        "fontScale": { "type": "number", "minimum": 1, "maximum": 1.6 }
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 2 },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "action"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 32 },
              "action": { "enum": ["call", "messages", "camera", "gallery", "app"] },
              "package": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$", "maxLength": 150, "description": "Required for action app, forbidden otherwise." },
              "label": { "type": "string", "minLength": 1, "maxLength": 24 },
              "icon": { "enum": ["call", "sms", "camera", "photos", "favorite", "home", "person", "music", "tv", "sun", "apps"] }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}

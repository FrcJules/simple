# Hub: shared secret the phone uses to push events (min 16 chars, generate with `openssl rand -hex 32`)
PRESENCE_PAIRING_TOKEN=
# Hub: token the display uses to read events (min 16 chars, must differ from the pairing token)
PRESENCE_DISPLAY_TOKEN=
# Hub: the only browser origin allowed to read events
PRESENCE_DISPLAY_ORIGIN=http://localhost:5173
PORT=8787
# Display (build time): same value as PRESENCE_DISPLAY_TOKEN, and the hub address
# VITE_DISPLAY_TOKEN=
# VITE_HUB_URL=http://localhost:8787
# Hub: HTTPS port for the phone, and where the self-signed certificate lives (keep private)
# PRESENCE_TLS_PORT=8788
# PRESENCE_TLS_DIR=./data/tls

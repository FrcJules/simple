# Hub: OPTIONAL static secret a phone can use to push events (min 16 chars, `openssl rand -hex 32`). Leave empty: phones pair with
# the QR code (`npm run pair -w @simple/hub`) and get their own revocable token (`npm run devices` / `npm run revoke -- <id>`).
# SIMPLE_PAIRING_TOKEN=
# Hub: where it keeps paired devices (hashes only) and one-time pairing claims; SIMPLE_HOST = the address printed in the pairing QR code
# SIMPLE_DATA_DIR=./data
# SIMPLE_HOST=
# Hub: token the display uses to read events (min 16 chars, must differ from the pairing token)
SIMPLE_DISPLAY_TOKEN=
# Hub: the only browser origin allowed to read events
SIMPLE_DISPLAY_ORIGIN=http://localhost:5173
PORT=8787
# Display (build time): same value as SIMPLE_DISPLAY_TOKEN, and the hub address
# VITE_DISPLAY_TOKEN=
# VITE_HUB_URL=http://localhost:8787
# Hub: HTTPS port for the phone, and where the self-signed certificate lives (keep private)
# SIMPLE_TLS_PORT=8788
# SIMPLE_TLS_DIR=./data/tls
# Hub: weather on the home display (ADR 0006), OFF unless both are set. Coordinates of your TOWN (they are rounded to 0.1° before being sent).
# SIMPLE_WEATHER_LAT=
# SIMPLE_WEATHER_LON=
# Hub: folder of family photos for the slideshow, and seconds per photo (display build time)
# SIMPLE_PHOTOS_DIR=./data/photos
# VITE_SLIDE_SECONDS=30


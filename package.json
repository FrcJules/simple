{
  "name": "simple",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/hub", "apps/display"],
  "scripts": {
    "dev:hub": "npm run dev -w @simple/hub",
    "dev:display": "npm run dev -w @simple/display",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}

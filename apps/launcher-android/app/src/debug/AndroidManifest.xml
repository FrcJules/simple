<?xml version="1.0" encoding="utf-8"?>
<!--
  Test builds only: "direct mode" (ADR 0007), for a hand-installed build that Android does not let become the default SMS app.
  It reads every received SMS with RECEIVE_SMS while NOT being the default app, which Google Play does not allow: the Play build
  only uses the default-SMS role (src/main/AndroidManifest.xml, BuildConfig.SMS_DIRECT_MODE_OFFERED = false).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Told of every received SMS when we are NOT the default app (needs RECEIVE_SMS); the system only sends it with this permission. -->
        <receiver
            android:name=".sms.SmsReceivedReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

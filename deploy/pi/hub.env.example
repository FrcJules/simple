# Copié dans /etc/simple/hub.env (propriétaire root, droits 0640 groupe simple). Ne jamais le mettre dans le dépôt.
# Jeton de l'écran maison (16 caractères minimum) : `openssl rand -hex 24`. Le même sert à construire l'écran (VITE_DISPLAY_TOKEN).
SIMPLE_DISPLAY_TOKEN=
VITE_DISPLAY_TOKEN=
SIMPLE_DISPLAY_ORIGIN=http://127.0.0.1:5173
VITE_HUB_URL=http://127.0.0.1:8787
# Prénom affiché sur l'écran maison.
VITE_SENIOR_NAME=
# Adresse du Pi sur le réseau de la maison (utile si elle n'est pas détectée), et port HTTPS pour les téléphones.
# SIMPLE_HOST=192.168.1.66
# SIMPLE_TLS_PORT=8788

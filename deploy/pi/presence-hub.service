# Hub Simple : reçoit les événements du téléphone, les diffuse à l'écran. Installé par docs/pi-install.md.
[Unit]
Description=Simple hub
After=network-online.target
Wants=network-online.target

[Service]
User=presence
Group=presence
WorkingDirectory=/opt/presence
EnvironmentFile=/etc/presence/hub.env
Environment=PRESENCE_DATA_DIR=/var/lib/presence
Environment=PRESENCE_TLS_DIR=/var/lib/presence/tls
ExecStart=/usr/bin/node apps/hub/dist/main.js
Restart=on-failure
RestartSec=5
# Durcissement : le hub n'écrit que dans /var/lib/presence et n'a besoin d'aucun droit particulier.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/presence
StateDirectory=presence
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
